# Copie este arquivo para ".env" e ajuste os valores.
# NUNCA versione o arquivo ".env" real (ele já está no .gitignore).

# --- Aplicação ---
APP_NAME="Sentry Maintenance API"
APP_ENV=development
DEBUG=True

# --- Banco de dados ---
# Usada pelo contêiner PostgreSQL; gere uma senha exclusiva e forte.
POSTGRES_PASSWORD=troque-por-uma-senha-forte
# Formato: postgresql+psycopg2://usuario:senha@host:porta/nome_banco
DATABASE_URL=postgresql+psycopg2://sentry:troque-por-uma-senha-forte@db:5432/sentry_maintenance
# Opcional — se vazio, os testes usam SQLite em memória e não precisam
# de Docker. Para validar com PostgreSQL, use uma URL de banco dedicado,
# por exemplo: postgresql+psycopg2://sentry:sentry@db:5432/sentry_maintenance_test
TEST_DATABASE_URL=

# --- Segurança / JWT ---
# Gere uma chave forte, ex: openssl rand -hex 32
SECRET_KEY=troque-esta-chave-em-producao
ALGORITHM=HS256
JWT_ISSUER=sentry-maintenance-api
JWT_AUDIENCE=sentry-maintenance-clients
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
CORS_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Proteção contra abuso ---
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REDIS_URL=redis://redis:6379/0
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=900
REGISTER_RATE_LIMIT=5
REGISTER_RATE_WINDOW_SECONDS=3600
REFRESH_RATE_LIMIT=60
REFRESH_RATE_WINDOW_SECONDS=900

# --- Upload de arquivos ---
UPLOAD_DIR=app/uploads
MAX_UPLOAD_SIZE_MB=10
