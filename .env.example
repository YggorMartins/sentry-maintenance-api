# Copie este arquivo para ".env" e ajuste os valores.
# NUNCA versione o arquivo ".env" real (ele já está no .gitignore).

# --- Aplicação ---
APP_NAME="Sentry Maintenance API"
APP_ENV=development
DEBUG=True

# --- Banco de dados ---
# Formato: postgresql+psycopg2://usuario:senha@host:porta/nome_banco
DATABASE_URL=postgresql+psycopg2://sentry:sentry@db:5432/sentry_maintenance
# Opcional — se vazio, os testes usam automaticamente
# "sentry_maintenance_test" no mesmo servidor (criado sozinho no
# primeiro `pytest`).
TEST_DATABASE_URL=

# --- Segurança / JWT ---
# Gere uma chave forte, ex: openssl rand -hex 32
SECRET_KEY=troque-esta-chave-em-producao
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
CORS_ORIGINS=*

# --- Upload de arquivos ---
UPLOAD_DIR=app/uploads
MAX_UPLOAD_SIZE_MB=10
